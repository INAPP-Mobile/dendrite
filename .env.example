# Dendrite on Railway
# One variable is set by the template; everything else is injected by Railway.
# Copy this file to .env only if you run the wrapper outside Railway.

# Admin account created on first boot (username baked into the image).
DENDRITE_ADMIN_USER=admin
# Admin password. On Railway this comes from the template variable
# DENDRITE_ADMIN_PASSWORD, generated fresh per install. Minimum 8 characters.
DENDRITE_ADMIN_PASSWORD=

# Injected by Railway automatically — do not set these yourself:
# PORT — the port Dendrite binds via --http-bind-address.
# RAILWAY_PUBLIC_DOMAIN — becomes the Matrix server_name at first boot and
# is pinned forever (Matrix user IDs are @user:server_name).
